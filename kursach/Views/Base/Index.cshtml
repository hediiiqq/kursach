@model IEnumerable<kursach.Models.BaseModel>
@section Styles{
    <link rel="stylesheet" href="css/index.css" asp-append-version="true"/>
}
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1>List</h1>
    <p><a asp-controller="Base" asp-action="Create">Create thing</a></p>
</div>
<section>
    <p>List of shit</p>
</section>
<section class="catalog-grid">
    @foreach (var item in Model)
    {
        <article class="product-card">
            <div class="product-card-body">
                <p>@item.Title</p>
                <p><img src="@item.ImageURL" alt="img"/></p>
                <p>@item.ShortDescription</p>
                <p>@item.TimeToCookInMinutes</p>
                <p>@item.Ingridients</p>
                <p>@item.FullDescription</p>
                <p><a asp-action="Edit" asp-controller="Base" asp-route-id="@item.Id">Edit</a></p>
                <form asp-controller="Base" asp-action="Delete" method="post" asp-route-id="@item.Id">
                    <input type="submit" value="Delete"/>
                </form>
            </div>
        </article>
    }
</section>